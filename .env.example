# IMPORTANTE: use o MESMO valor de JWT_SECRET nas Variables do Railway dos
# outros 3 dashboards (Tráfego Pago, Ações Sazonais, Redes Sociais).
# É isso que permite o login único: a plataforma emite um token e os outros
# dashboards já reconhecem esse token como válido, sem pedir login de novo.
JWT_SECRET=troque-por-um-valor-aleatorio-longo-e-igual-nos-4-projetos

PORT=3000

# URLs de produção de cada dashboard (sem barra no final).
# Preencha com o domínio real de cada um no Railway (Settings > Networking > Domain).
TRAFEGO_PAGO_URL=https://dashboard-trafego-pago-production.up.railway.app
ACOES_SAZONAIS_URL=https://SUBSTITUA-PELO-DOMINIO-DA-ACOES-SAZONAIS.up.railway.app
REDES_SOCIAIS_URL=https://dashboard-redes-sociais-production.up.railway.app
