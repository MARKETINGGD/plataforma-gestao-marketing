# IMPORTANTE: use o MESMO valor de JWT_SECRET nas Variables do Railway dos
# outros 3 dashboards (Tráfego Pago, Ações Sazonais, Redes Sociais).
# É isso que permite o login único: a plataforma emite um token e os outros
# dashboards já reconhecem esse token como válido, sem pedir login de novo.
JWT_SECRET=troque-por-um-valor-aleatorio-longo-e-igual-nos-4-projetos

PORT=3000

# URLs de produção de cada dashboard (sem barra no final).
# Preencha com o domínio real de cada um no Railway (Settings > Networking > Domain).
TRAFEGO_PAGO_URL=https://dashboard-trafego-pago-production.up.railway.app
ACOES_SAZONAIS_URL=https://SUBSTITUA-PELO-DOMINIO-DA-ACOES-SAZONAIS.up.railway.app
REDES_SOCIAIS_URL=https://dashboard-redes-sociais-production.up.railway.app

# 54ª rodada — conectar o Agendamento de Redes Sociais à API de verdade da
# Meta (Instagram/Facebook). App "Papoi - Agendamento Social" criado no
# Meta for Developers (developers.facebook.com), dentro do Business Manager
# da GhelPlus. Pegue os valores em Configurações do app > Básico.
META_APP_ID=
META_APP_SECRET=
# URL pública da própria Papoi (sem barra no final) — usada pra montar a
# Redirect URI do OAuth e pra saber pra onde mandar o navegador de volta
# depois da autorização. Precisa ser EXATAMENTE a mesma URL cadastrada no
# Meta for Developers (Login do Facebook para Empresas > Configurações >
# URIs de redirecionamento do OAuth válidos: <PAPOI_BASE_URL>/api/social-accounts/meta/callback).
PAPOI_BASE_URL=https://www.papoi.com.br

# 81ª rodada — notificação PUSH de verdade (chega mesmo com o app/aba
# fechado, diferente da notificação do sistema da 80ª rodada, que só
# funciona com a Papoi aberta na tela). Esse par de chaves "VAPID" NÃO
# depende de aprovação de nenhuma rede social nem de nenhum app externo
# -- foi gerado 1 vez só, pela própria Papoi, e vale pra sempre (nunca
# precisa trocar, a não ser que a Raquel quisesse, por algum motivo,
# invalidar todas as inscrições de todo mundo de uma vez e recomeçar).
# Copie os 2 valores abaixo exatamente assim nas Variables do Railway --
# sem eles, a Papoi funciona normalmente em tudo o mais, só a notificação
# com o app fechado fica indisponível (silenciosamente, sem travar nada).
VAPID_PUBLIC_KEY=BDAXnNTUYx8D0kccfPtcLmkk3jdaviumkrAjr7YzyS7-waaxYivYEDUBbg1muhxDc6Kbgyn7UlHnM18Pq4GM5Vs
VAPID_PRIVATE_KEY=z0AYT31_VaPOuq7FxkUvzfMg8IaYbOFp__WJq-CJ7o8
VAPID_SUBJECT=mailto:marketingghelplus@gmail.com
